{
  "name": "harbor-git",
  "version": "1.5.0",
  "description": "An independent desktop Git workspace client",
  "author": "HarborGit contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "icons": "electron scripts/render-icons.cjs",
    "test": "tsx --test tests/git.test.ts tests/graph-ai.test.ts tests/remotes.test.ts tests/updates.test.ts tests/history-actions.test.ts",
    "test:history": "tsx --test tests/history-actions.test.ts",
    "test:updates": "tsx --test tests/updates.test.ts",
    "test:updates:runtime": "node scripts/test-update-runtime.mjs",
    "verify:updates": "node scripts/verify-update-metadata.mjs",
    "test:ui": "playwright test",
    "test:portable": "node scripts/smoke-portable.mjs",
    "pack": "npm run build && node -e \"require('electron')\" && electron-builder --win --dir --x64 -c.electronDist=node_modules/electron/dist",
    "dist": "npm run dist:setup",
    "dist:setup": "npm run build && node -e \"require('electron')\" && electron-builder --win nsis --x64 -c.electronDist=node_modules/electron/dist --publish never",
    "dist:portable": "npm run build && node -e \"require('electron')\" && electron-builder --win portable --x64 -c.electronDist=node_modules/electron/dist --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64 --publish never"
  },
  "dependencies": {
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "dev.harborgit.desktop",
    "productName": "HarborGit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "releaseInfo": { "releaseNotesFile": "release-notes.md" },
    "mac": {
      "publish": null,
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/harborgit-1024.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "HarborGit-${version}-macOS-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "win": {
      "publish": [{ "provider": "github", "owner": "Lord-GEO", "repo": "HarborGit", "releaseType": "release", "channel": "latest" }],
      "target": [
        "nsis"
      ],
      "icon": "assets/harborgit.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "HarborGit-${version}-Setup-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HarborGit",
      "uninstallDisplayName": "HarborGit",
      "installerIcon": "assets/harborgit.ico",
      "uninstallerIcon": "assets/harborgit.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "portable": {
      "artifactName": "HarborGit-${version}-Windows-x64.exe"
    }
  }
}
